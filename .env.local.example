# Environment Variables for Local Terraform Testing
# Copy this file to .env.local and fill in your values
# .env.local is git-ignored and will never be committed

# IBM MQ Credentials
export IBM_MQ_HOST="your-mq-host.example.com"
export IBM_MQ_PORT="1414"
export IBM_MQ_CHANNEL="DEV.CHANNEL"
export IBM_MQ_PASSWORD="your-password-here"

# MDMAE API
export MDMAE_URL="https://mdmae-api-dev.example.com"

# AWS Region (optional, defaults to ca-central-1)
export AWS_REGION="ca-central-1"

# Usage:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Edit .env.local with your actual values
# 3. Load variables: source .env.local
# 4. Test: echo $IBM_MQ_HOST